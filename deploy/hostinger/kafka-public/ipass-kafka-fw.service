# Row 503 (task A): re-applies the Kafka front outbound-drop rule after a reboot or a Docker restart.
# Without it the DOCKER-USER rule is gone after a reboot and br-ipass-kpub may open new connections again.
# Install path (reviewed and run by the owner, never by an agent): /etc/systemd/system/ipass-kafka-fw.service.
# Commands and removal: deploy/hostinger/README.md, section "Firewall rules survive a reboot".
[Unit]
Description=iPass Kafka front: no new outbound connections from br-ipass-kpub (DOCKER-USER rule)
Documentation=file:///docker/ipass/README.md
After=docker.service
Wants=docker.service
# A restart of docker.service restarts this unit too (stop = rule off, start = rule on), so the rule is re-checked after it.
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# /bin/sh <script>: does not depend on the execute bit of the copied file (it is mode 644 in git).
ExecStart=/bin/sh /docker/ipass/kafka-public/kafka-public-fw.sh on
# Fails the unit (visible in systemctl status) if the rule is not in place after `on`.
ExecStartPost=/bin/sh /docker/ipass/kafka-public/kafka-public-fw.sh check
ExecStop=/bin/sh /docker/ipass/kafka-public/kafka-public-fw.sh off
TimeoutStartSec=30
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
