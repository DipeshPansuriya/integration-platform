# Variable NAMES only - no values. bootstrap-env.sh writes the real /docker/ipass/.env ON THE SERVER (root, 600).
# Never copy a value here, into git, a chat or the hub (## credential-storage).
# (Named env.example, not .env.example: the repo's .gitignore swallows .env*.)
# --- not secret, set by bootstrap-env.sh from its arguments
IPASS_DOMAIN=
IMAGE_TAG=
# --- optional, have defaults in compose.yaml
IPASS_IMAGE_PREFIX=
IPASS_LOG_DRIVER=
IPASS_PROFILES=
IPASS_DESTINATION_HOSTS=
IPASS_SHOWCASE_LOCAL_HOSTS=
IPASS_SHOWCASE_LOCAL_PORTS=
KAFKA_PARTITIONS=
# --- secrets, generated on the server
POSTGRES_PASSWORD=
DB_MIGRATION_PASSWORD=
DB_PASSWORD=
BACKUP_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KC_BOOTSTRAP_ADMIN_PASSWORD=
CONSOLE_OIDC_CLIENT_SECRET=
PLATFORM_ADMIN_CLIENT_SECRET=
OPERATOR_AGENT_CLIENT_SECRET=
PLATFORM_CREDENTIAL_KEK_K1=
SHOWCASE_PASSWORD_ADMIN_A=
SHOWCASE_PASSWORD_CONFIGURATOR_A=
SHOWCASE_PASSWORD_APPROVER_A=
SHOWCASE_PASSWORD_ADMIN_B=
