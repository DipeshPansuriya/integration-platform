  "type": "object",
  "required": [
    "orderNo",
    "customer",
    "qty",
    "contractVersion"
  ],
  "properties": {
    "orderNo": {
      "type": "string"
    },
    "customer": {
      "type": "string"
    },
    "qty": {
      "type": "number"
    },
    "contractVersion": {
      "type": "string"
    }
  }
}
