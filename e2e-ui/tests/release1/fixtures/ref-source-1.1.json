{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "orderNo",
    "customer",
    "qty"
  ],
  "properties": {
    "orderNo": {
      "type": "string",
      "minLength": 1
    },
    "customer": {
      "type": "string"
    },
    "qty": {
      "type": "number",
      "minimum": 0
    },
    "note": {
      "type": "string"
    }
  }
}
