{
  "realm": "platform",
  "displayName": "Integration platform",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 300,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "clientScopes": [
    {
      "name": "basic",
      "description": "OpenID Connect scope for the subject and authentication time (the access token's sub)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "auth_time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "AUTH_TIME",
            "introspection.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "auth_time",
            "jsonType.label": "long"
          }
        }
      ]
    },
    {
      "name": "platform-api-audience",
      "description": "ADR-007 Decision 3 (S-j): adds the platform API audience to every access token, so a client needs no per-client audience setup",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "platform-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "${OIDC_AUDIENCE}",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "platform-admin-roles",
      "description": "The client roles of realm-management in the platform-admin service account's token (resource_access), which Keycloak's Admin REST API checks. Assigned to platform-admin only - never a realm default, so no source or console token carries roles",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "resource_access.realm-management.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "false",
            "usermodel.clientRoleMapping.clientId": "realm-management"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "basic",
    "platform-api-audience"
  ],
  "defaultOptionalClientScopes": [],
  "clients": [
    {
      "clientId": "platform-console",
      "name": "Console (backend for frontend)",
      "description": "ADR-007 Decision 1: the platform's backend is the confidential client; Authorization Code with PKCE S256 only",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${CONSOLE_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "${CONSOLE_OIDC_REDIRECT_URI}"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${CONSOLE_POST_LOGOUT_REDIRECT_URI}",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "use.refresh.tokens": "true"
      },
      "defaultClientScopes": [
        "basic",
        "platform-api-audience"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "platform-admin",
      "name": "Platform credential administration (service account)",
      "description": "ADR-007 Decision 3: creates, disables and rotates source-system clients through the Admin REST API; holds only manage-clients and view-clients",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${PLATFORM_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      },
      "defaultClientScopes": [
        "basic",
        "platform-api-audience",
        "platform-admin-roles"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "operator-agent",
      "name": "Operator agent (AI agent, service account)",
      "description": "ADR-012 Decision 5: AI agent's machine credential client - ops automation, client-credentials only, token-audited (T-147).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      },
      "secret": "${OPERATOR_AGENT_CLIENT_SECRET}",
      "defaultClientScopes": [
        "basic",
        "platform-api-audience"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "service-account-platform-admin",
      "enabled": true,
      "serviceAccountClientId": "platform-admin",
      "realmRoles": [],
      "clientRoles": {
        "realm-management": [
          "manage-clients",
          "view-clients"
        ]
      }
    }
  ]
}
