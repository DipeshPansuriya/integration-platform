# Variable NAMES read by compose/compose.yaml - values stay empty here (R07).
# Set them in your shell from the OS secret store before `docker compose up`; never commit a filled copy.
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD=
# Keycloak (ADR-007 Decision 1): its own database and login on the same server, and the admin of the master realm.
KEYCLOAK_DB_NAME=
KEYCLOAK_DB_USERNAME=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
# Realm `platform` placeholders (compose/keycloak/platform-realm.json) - the backend reads the same names.
OIDC_AUDIENCE=
CONSOLE_OIDC_CLIENT_SECRET=
CONSOLE_OIDC_REDIRECT_URI=
CONSOLE_POST_LOGOUT_REDIRECT_URI=
PLATFORM_ADMIN_CLIENT_SECRET=
OPERATOR_AGENT_CLIENT_SECRET=
# Kafbat UI login (E8-F2-S1, T-077): Kafbat requires its own login on the operations network (R07: names only,
# values stay in the OS secret store).
KAFBAT_UI_USER=
KAFBAT_UI_PASSWORD=
# Artemis login (E15 e2e profile, F17/T143): compose interpolates every service, so set these for any compose command.
ARTEMIS_USER=
ARTEMIS_PASSWORD=
