<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Stack fixed by the approved plan: Java 25, Spring Boot 4.1.1, Camel 4.22.1, kafka-clients 4.3.1. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>io.integrationplatform</groupId>
  <artifactId>integration-platform-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>integration-platform-parent</name>
  <description>Configuration-driven integration platform - parent build (modular monolith, ADR-001)</description>

  <modules>
    <!-- E2 seam (arjun-fullstack): shared value types (no Spring, no other module) and Delivery persistence. -->
    <module>platform-domain</module>
    <module>platform-delivery</module>
    <module>platform-routing</module>
    <module>platform-ingest</module>
    <!-- E3 seam (arjun-fullstack): platform-config skeleton registered so lanes B/C compile without touching this
         file; its insides (tables, API, lifecycle) stay in the lanes' own diffs. -->
    <module>platform-config</module>
    <!-- E7||E8 seam (arjun-fullstack, F5): platform-transform registered EMPTY (skeleton + api only). Lane A's spike
         (T-030..T-032) uses it test scope only; lane B1's port (T-108) fills src/main inside its own diff. -->
    <module>platform-transform</module>
    <module>platform-tenancy</module>
    <module>platform-app</module>
    <!-- Test-only module: ArchUnit rules over every module's package (ADR-001 item 2, R08). Not part of the deployable. -->
    <module>arch-test</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <camel-spring-boot.version>4.22.1</camel-spring-boot.version>
    <!-- Overrides Boot's managed 4.2.1: the one kafka-clients version Camel 4.22.1 is built on (plan:198, R12). -->
    <kafka.version>4.3.1</kafka.version>
    <!-- The networknt version Camel 4.22.1 manages (camel-parent 4.22.1); the Camel Spring Boot BOM does not manage it. -->
    <networknt-json-schema-validator.version>2.0.1</networknt-json-schema-validator.version>
    <!-- ArchUnit is named by ADR-001 item 2 and architecture.md section 2 (arch-test); not managed by Boot. -->
    <archunit.version>1.4.2</archunit.version>
    <!-- E3 seam (arjun-fullstack): springdoc publishes the backend's OpenAPI document (/v3/api-docs) for T-158's
         generated client and T-094's contract test. The 3.x line targets Spring Boot 4; not managed by Boot. -->
    <springdoc.version>3.1.1</springdoc.version>
    <!-- E3 T36: the OpenAPI annotations platform-config declares its admin responses with - exactly the version
         springdoc ${springdoc.version} already pulls transitively (swagger-core-jakarta), so no new library. -->
    <swagger-annotations.version>2.2.55</swagger-annotations.version>
    <!-- R13 / ADR-010:59: the platform's one resilience library, at the version Camel 4.22.1 manages for
         camel-resilience4j; camel-spring-boot-bom does not manage the plain modules. -->
    <resilience4j.version>2.4.0</resilience4j.version>
    <!-- E5 seam (arjun-fullstack, F13): ADR-011:103 - OpenAPI documents are imported with swagger-parser (E5 T-105).
         The OpenAPI 3.x parser module only (swagger-parser-v3), not the umbrella artifact that adds the Swagger 2.0
         converter; release 2.1.48 (Maven Central, 2026-08-31). Not managed by Boot. -->
    <swagger-parser.version>2.1.48</swagger-parser.version>
    <!-- E6 seam (sanjay-developer, T-024): the rules engine of ADR-003 - GoRules ZEN's Java binding, pinned exactly.
         MIT (licenses block of zen-engine-2.1.1.pom on Maven Central); no transitive dependencies (empty
         dependencies block), so dependencyConvergence and R12 are untouched. Its jar carries the native library per
         platform (win32-x86-64/zen_uniffi.dll included) and binds it through java.lang.foreign. -->
    <zen-engine.version>2.1.1</zen-engine.version>

    <!-- E7 seam (arjun-fullstack, F5): ADR-006 (Accepted, Dipesh 2026-10-12) - the transformation engine is the
         JSONata language through Dashjoin's Java port, called directly by platform-transform (E7 T-108). Apache-2.0
         (LICENSE of dashjoin/jsonata-java on GitHub, release 0.9.10 on Maven Central). Pinning is the seam; the
         engine-candidate additions for the spike stay in lane A's diff (test scope, platform-transform/pom.xml). -->
    <jsonata.version>0.9.10</jsonata.version>

    <!-- E14 seam (arjun-fullstack, F8): ADR-012 Decision 1 - the scheduler engine is db-scheduler via its Spring Boot
         starter, Apache-2.0. Version re-checked against Maven Central's maven-metadata at seam time: 16.12.0 is the
         newest release. Pinning is the seam; the modules that use it add the starter themselves (T-056:
         platform-config + platform-app - no new module, config owns rows/API, app owns wiring, ADR-012 section 2). -->
    <db-scheduler.version>16.12.0</db-scheduler.version>

    <!-- Surefire (R03, R06): container tests are excluded unless -Pcontainer. -->
    <surefire.groups></surefire.groups>
    <surefire.excludedGroups>container</surefire.excludedGroups>
    <!-- Empty default so @{argLine} resolves when no agent (e.g. JaCoCo) sets it. -->
    <argLine></argLine>
    <!-- Fork JVM args for surefire (R06 small-run default; the container profile raises heap/metaspace
         because a full Boot 4 app context + testcontainer inside one fork exceeds the default pair
         (window-1 evidence 2026-10-13: fork died malloc, hs_err on platform-app 2a4b579). -->
    <surefireJvmArgs>-Duser.timezone=Etc/UTC -Xmx256m -XX:MaxMetaspaceSize=192m -XX:+UseSerialGC -Djdk.attach.allowAttachSelf=true</surefireJvmArgs>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.apache.camel.springboot</groupId>
        <artifactId>camel-spring-boot-bom</artifactId>
        <version>${camel-spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-bom</artifactId>
        <version>${resilience4j.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${networknt-json-schema-validator.version}</version>
      </dependency>
      <!-- swagger-parser-v3 depends on the javax swagger-core/models/annotations (2.2.53); springdoc brings the
           jakarta builds of the same packages (2.2.55). Two jars per package on one classpath is a split package, so
           the javax trio is excluded and swagger-core-jakarta at springdoc's version stands in (same API). -->
      <dependency>
        <groupId>io.swagger.parser.v3</groupId>
        <artifactId>swagger-parser-v3</artifactId>
        <version>${swagger-parser.version}</version>
        <exclusions>
          <exclusion>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-core</artifactId>
          </exclusion>
          <exclusion>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-models</artifactId>
          </exclusion>
          <exclusion>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>io.swagger.core.v3</groupId>
        <artifactId>swagger-core-jakarta</artifactId>
        <version>${swagger-annotations.version}</version>
      </dependency>
      <!-- Security fix: pinned to 1.11.4, above both transitive asks (camel-kafka 1.11.1, kafka-clients 4.3.1
           1.10.2), closing Dependabot alerts #1-#5 (GHSA-mcr4-qmvw-px4g High and four lower lz4-java advisories);
           the pin also keeps dependencyConvergence satisfied. -->
      <dependency>
        <groupId>at.yawk.lz4</groupId>
        <artifactId>lz4-java</artifactId>
        <version>1.11.4</version>
      </dependency>
      <dependency>
        <groupId>io.integrationplatform</groupId>
        <artifactId>platform-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.integrationplatform</groupId>
        <artifactId>platform-delivery</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.integrationplatform</groupId>
        <artifactId>platform-routing</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.integrationplatform</groupId>
        <artifactId>platform-ingest</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.integrationplatform</groupId>
        <artifactId>platform-tenancy</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <!-- E3 seam: lane B/C's configuration module; the deployable wires it in (ADR-001). -->
        <groupId>io.integrationplatform</groupId>
        <artifactId>platform-config</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- E7||E8 seam (arjun-fullstack, F5): the transform engine module - the deployable and arch-test reference it. -->
      <dependency>
        <groupId>io.integrationplatform</groupId>
        <artifactId>platform-transform</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- E3 seam: OpenAPI document generation for the UI's typed client (T-158) and the contract test (T-094). -->
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>io.swagger.core.v3</groupId>
        <artifactId>swagger-annotations-jakarta</artifactId>
        <version>${swagger-annotations.version}</version>
      </dependency>
      <dependency>
        <groupId>io.gorules</groupId>
        <artifactId>zen-engine</artifactId>
        <version>${zen-engine.version}</version>
      </dependency>
      <dependency>
        <groupId>com.dashjoin</groupId>
        <artifactId>jsonata</artifactId>
        <version>${jsonata.version}</version>
      </dependency>
      <!-- E14 seam (arjun-fullstack, F8): ADR-012 Decision 1 (Accepted, Dipesh 2026-10-12) - the scheduler engine;
           its task table is created by Flyway (V2_2_1400, scheduler schema), never auto-created. -->
      <dependency>
        <groupId>com.github.kagkarlsson</groupId>
        <artifactId>db-scheduler-spring-boot-starter</artifactId>
        <version>${db-scheduler.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Every module resolves mockito-core, which the surefire argLine loads as a java agent. -->
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- T-087, R12: the dependency rules fail the build at validate (planted violations: build-checks/). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-stack-rules</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
                <bannedDependencies>
                  <message>R12: spring-kafka is never allowed; kafka-clients only at ${kafka.version}; networknt json-schema-validator only at ${networknt-json-schema-validator.version}.</message>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>org.springframework.kafka</exclude>
                    <exclude>org.apache.kafka:kafka-clients</exclude>
                    <exclude>com.networknt:json-schema-validator</exclude>
                  </excludes>
                  <includes>
                    <include>org.apache.kafka:kafka-clients:[${kafka.version}]</include>
                    <include>com.networknt:json-schema-validator:[${networknt-json-schema-validator.version}]</include>
                  </includes>
                </bannedDependencies>
                <dependencyConvergence/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>dependency-paths</id>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <groups>${surefire.groups}</groups>
          <excludedGroups>${surefire.excludedGroups}</excludedGroups>
          <argLine>@{argLine} ${surefireJvmArgs} -javaagent:${org.mockito:mockito-core:jar}</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- ./mvnw -Pcontainer test runs ONLY the container group (one Docker suite at a time, R06). -->
    <profile>
      <id>container</id>
      <properties>
        <surefire.groups>container</surefire.groups>
        <surefire.excludedGroups></surefire.excludedGroups>
        <!-- ponytail override: only heap/metaspace grow; flags stay. Serialized suites keep R06 cost bounded. -->
        <surefireJvmArgs>-Duser.timezone=Etc/UTC -Xmx1g -XX:MaxMetaspaceSize=512m -XX:+UseSerialGC -Djdk.attach.allowAttachSelf=true</surefireJvmArgs>
      </properties>
    </profile>
  </profiles>
</project>
