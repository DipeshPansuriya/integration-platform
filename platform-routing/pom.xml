<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.integrationplatform</groupId>
    <artifactId>integration-platform-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>platform-routing</artifactId>
  <name>platform-routing</name>
  <description>Data plane - the only Camel module (R12, ADR-010): Kafka consumers, route templates, target adapters</description>

  <dependencies>
    <dependency>
      <groupId>org.apache.camel.springboot</groupId>
      <artifactId>camel-spring-boot-starter</artifactId>
    </dependency>
    <!-- Brings kafka-clients; its version is held to kafka.version by the parent (R12). -->
    <dependency>
      <groupId>org.apache.camel.springboot</groupId>
      <artifactId>camel-kafka-starter</artifactId>
    </dependency>
    <!-- E10 T98 (ADR-018): the MQ-CSV broker send. The Artemis Jakarta client (version from the spring-boot BOM)
         is used only in routing.adapter.mq, which builds its own connection factory per target
         (reconnectAttempts=0); Boot's Artemis/JMS auto-configurations stay excluded (MqAutoConfigurationFilter). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-artemis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.camel.springboot</groupId>
      <artifactId>camel-jms-starter</artifactId>
    </dependency>
    <!-- E2 lane C (T-193): the stage-2 claim runs the delivery tables' one claim order inside this module's
         claim transaction; spring-jdbc/spring-tx come with it transitively (R12: Camel stays in this module,
         the claim code itself imports no Camel or Kafka client). -->
    <dependency>
      <groupId>io.integrationplatform</groupId>
      <artifactId>platform-delivery</artifactId>
    </dependency>
    <!-- E5 lane C (T-185, ADR-007 Decision 7 rule 6): target credentials are decrypted only here, at send time; the
         sealed rows, the key-encryption keys and the readiness signal are the configuration module's public
         config.credential.api (a read of published configuration - ADR-001 forbids only writing config from the
         data plane). No cycle: platform-config depends on platform-tenancy only. -->
    <dependency>
      <groupId>io.integrationplatform</groupId>
      <artifactId>platform-config</artifactId>
    </dependency>
    <!-- E8 lane B (T-110): the ingest outbox port types are the relay's publishing contract - the Kafka adapter
         here implements io.integrationplatform.ingest.port.PublishPort (ADR-015: the adapter's placement is this
         module). Until this line the reach was transitive through platform-delivery; the direct edge is the same
         graph edge named where it is used. No cycle: platform-ingest imports no routing class. -->
    <dependency>
      <groupId>io.integrationplatform</groupId>
      <artifactId>platform-ingest</artifactId>
    </dependency>
    <!-- E10 narrow (T-050): the API target adapter's reads go through TenantScopedRepository (R08) - the
         tenancy base is where its SQL must run, so the edge is named here the same way the ingest edge is.
         No cycle: platform-tenancy imports no routing class. -->
    <dependency>
      <groupId>io.integrationplatform</groupId>
      <artifactId>platform-tenancy</artifactId>
    </dependency>
    <!-- E8 lane C2 (T-191, ADR-005 Decision 12): the stage consumers' database breaker per consumer group
         (Resilience4j plain modules, version from resilience4j.version), Micrometer metrics and an observation
         (span) per consumed record, and the consumer-lag check. -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-circuitbreaker</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-micrometer</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>
    <!-- E8 seam (F6, arjun): the Kafka Testcontainers the E8 lanes test with (T-044's harness builds on
         these); versions come from the spring-boot BOM's testcontainers-bom, as in platform-config/app.
         spring-boot-starter-test is contributed by the parent for every module. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-kafka</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- E8 lanes A + B (T-110/T-111, row278-integration merge): the pinned PostgreSQL container both suites
         need - lane A's stage fixture (message/payload migrations, protected-path tests, T-111) and lane B's
         same-key ordering gate (outbox -> relay -> the Kafka adapter -> a real broker, R05). Versions from the
         spring-boot BOM's testcontainers-bom, as platform-app's suite pins them. -->
    <!-- E9 lane A1 (T-116/T-119): the same pinned PostgreSQL container the delivery-ledger container proof runs
         against (one delivery_attempt row per layer-1 call on the real append-only tables) - one dependency
         block serves lanes A (E8) and A1 (E9). -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
