<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.integrationplatform</groupId>
    <artifactId>integration-platform-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>platform-app</artifactId>
  <name>platform-app</name>
  <description>The deployable: wiring, security chain, scheduler jobs, actuator (no business logic)</description>

  <dependencies>
    <dependency>
      <groupId>io.integrationplatform</groupId>
      <artifactId>platform-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>io.integrationplatform</groupId>
      <artifactId>platform-delivery</artifactId>
    </dependency>
    <dependency>
      <groupId>io.integrationplatform</groupId>
      <artifactId>platform-routing</artifactId>
    </dependency>
    <dependency>
      <groupId>io.integrationplatform</groupId>
      <artifactId>platform-ingest</artifactId>
    </dependency>
    <!-- E3 seam (arjun-fullstack): configuration module wired into the deployable so T-015/T-019's controllers and
         T-014/T-018's Flyway resources are on the runtime classpath. -->
    <dependency>
      <groupId>io.integrationplatform</groupId>
      <artifactId>platform-config</artifactId>
    </dependency>
    <dependency>
      <groupId>io.integrationplatform</groupId>
      <artifactId>platform-tenancy</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- E3 seam (arjun-fullstack): publishes the backend's OpenAPI document (/v3/api-docs) for T-158's typed
         client generation and T-094's contract test. api variant only - no swagger-ui webjars needed. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Test scope for the start proof (container group, R03); spring-boot-starter-test comes from the parent. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The only deployable: repackage runs here and nowhere else. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- The executable jar is attached as "-exec"; the main artifact stays a plain jar so arch-test can
               scan platform-app's classes like every other module's (E1 seam, R08). -->
          <classifier>exec</classifier>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
