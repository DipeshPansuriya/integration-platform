<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.integrationplatform</groupId>
    <artifactId>integration-platform-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>platform-app</artifactId>
  <name>platform-app</name>
  <description>The deployable: wiring, security chain, scheduler jobs, actuator (no business logic)</description>

  <dependencies>
    <dependency>
      <groupId>io.integrationplatform</groupId>
      <artifactId>platform-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>io.integrationplatform</groupId>
      <artifactId>platform-delivery</artifactId>
    </dependency>
    <dependency>
      <groupId>io.integrationplatform</groupId>
      <artifactId>platform-routing</artifactId>
    </dependency>
    <dependency>
      <groupId>io.integrationplatform</groupId>
      <artifactId>platform-ingest</artifactId>
    </dependency>
    <!-- E3 seam (arjun-fullstack): configuration module wired into the deployable so T-015/T-019's controllers and
         T-014/T-018's Flyway resources are on the runtime classpath. -->
    <dependency>
      <groupId>io.integrationplatform</groupId>
      <artifactId>platform-config</artifactId>
    </dependency>
    <!-- E7||E8 seam (arjun-fullstack, F5): the transform engine module on the deployable's classpath - empty at
         seam time, wired by lane B1's port in wave 1. -->
    <dependency>
      <groupId>io.integrationplatform</groupId>
      <artifactId>platform-transform</artifactId>
    </dependency>
    <dependency>
      <groupId>io.integrationplatform</groupId>
      <artifactId>platform-tenancy</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- E3 seam (arjun-fullstack): publishes the backend's OpenAPI document (/v3/api-docs) for T-158's typed
         client generation and T-094's contract test. api variant only - no swagger-ui webjars needed. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
    </dependency>
    <!-- E4 lane D (T-097, ADR-007 Decision 1): the console's server sessions live in PostgreSQL (Spring Session JDBC),
         so instances stay stateless. Tables: platform-tenancy's V2_4_1 migration; settings: tenancy-console.yml.
         Version from the Boot BOM. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-session-jdbc</artifactId>
    </dependency>
    <!-- E14 T-056 (sanjay-developer, F8): ADR-012 Decision 1 - the scheduler engine on the deployable's classpath;
         platform-app owns the runtime wiring, the run/alert wrapper and the placeholder handlers (ADR-012 section 2).
         Version managed in the parent pom (the seam). -->
    <dependency>
      <groupId>com.github.kagkarlsson</groupId>
      <artifactId>db-scheduler-spring-boot-starter</artifactId>
    </dependency>
    <!-- E14 T-062 (sanjay-developer, F8): ADR-012 section 6 - Prometheus counters for runs by outcome and the
         oldest-overdue gauge (computed at scrape time). Version from the Boot BOM. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Test scope for the start proof (container group, R03); spring-boot-starter-test comes from the parent. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The only deployable: repackage runs here and nowhere else. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- The executable jar is attached as "-exec"; the main artifact stays a plain jar so arch-test can
               scan platform-app's classes like every other module's (E1 seam, R08). -->
          <classifier>exec</classifier>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
