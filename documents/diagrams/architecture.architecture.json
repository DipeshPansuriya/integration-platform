  "cards": [
    {
      "dot": "cyan",
      "title": "One deployable",
      "items": [
        "Modules are Maven modules inside platform-app (ADR-001)",
        "Camel only in platform-routing; ArchUnit fails the build otherwise (ADR-010)",
        "Config written by the control plane, read as published versions only"
      ]
    },
    {
      "dot": "rose",
      "title": "Tenant isolation",
      "items": [
        "Tenant from the credential via our DB, never a claim or header (ADR-007, T1)",
        "Every query via TenantScopedRepository (R08, T2)",
        "RLS on every tenant table, stamped per transaction (ADR-009, T3-T4)",
        "Exactly four definer functions cross the boundary (T5)"
      ]
    },
    {
      "dot": "amber",
      "title": "Kafka carries work only",
      "items": [
        "Records carry ids; payloads stay in PostgreSQL (ADR-011 D7)",
        "No retry or delay topics; unreadable records go to platform.poison (ADR-005)",
        "platform-ledger and platform-audit read the same rows for tracking and audit"
      ]
    }
  ]
