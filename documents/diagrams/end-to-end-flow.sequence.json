      "id": "m24",
      "from": "ingest",
      "to": "source",
      "y": 1022,
      "label": "200 mapped, error, or 202 PENDING",
      "variant": "return",
      "note": "Over the 10 s budget the delivery continues on the async path"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Accepted means stored",
      "items": [
        "202 only after message, payload and outbox commit together (RPO zero)",
        "Bulk is split at intake: N records, k invalid, exactly N - k outbox rows",
        "Kafka records carry ids; the payload stays in PostgreSQL"
      ]
    },
    {
      "dot": "orange",
      "title": "Exactly two retry layers",
      "items": [
        "Layer 1: Camel redelivers transient failures within one attempt",
        "Layer 2: RETRY_WAIT rows, re-driven by the polling trigger",
        "Kafka retries nothing; poison is terminal and alerted"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure paths",
      "items": [
        "Ambiguous timeout: retried only if the target declares idempotent receive",
        "Permanent, mapping error or exhausted: DEAD_LETTERED, operator replay",
        "Stale claim (timeout + 60 s) is treated as ambiguous"
      ]
    }
  ]
}