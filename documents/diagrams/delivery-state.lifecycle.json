{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Integration Platform - Delivery States",
    "output": "delivery-state.archify.html",
    "quality_profile": "showcase",
    "viewBox": [
      1040,
      640
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "Claim and send"
    },
    {
      "id": "waits",
      "label": "Wait and ready"
    },
    {
      "id": "terminal",
      "label": "Held for order"
    }
  ],
  "states": [
    {
      "id": "pending",
      "type": "start",
      "label": "PENDING",
      "sublabel": "created",
      "lane": "main",
      "col": 0,
      "step": "01",
      "width": 96
    },
    {
      "id": "retry",
      "type": "failure",
      "label": "RETRY_WAIT",
      "sublabel": "waits in DB",
      "lane": "main",
      "col": 1,
      "width": 96,
      "yOffset": 150
    },
    {
      "id": "sending",
      "type": "active",
      "label": "SENDING",
      "sublabel": "claimed",
      "lane": "main",
      "col": 2,
      "step": "02",
      "width": 96
    },
    {
      "id": "delivered",
      "type": "success",
      "label": "DELIVERED",
      "sublabel": "terminal",
      "lane": "main",
      "col": 4,
      "step": "03",
      "width": 96
    },
    {
      "id": "due",
      "type": "active",
      "label": "DUE",
      "sublabel": "ready",
      "lane": "waits",
      "col": 0,
      "width": 96
    },
    {
      "id": "dead",
      "type": "failure",
      "label": "DEAD_LETTERED",
      "sublabel": "until replay",
      "lane": "waits",
      "col": 1,
      "width": 96
    },
    {
      "id": "held",
      "type": "waiting",
      "label": "HELD",
      "sublabel": "same key open",
      "lane": "terminal",
      "col": 0,
      "width": 96
    }
  ],
  "transitions": [
    {
      "id": "t-claim-first",
      "from": "pending",
      "to": "sending",
      "label": "claim + token",
      "variant": "emphasis"
    },
    {
      "id": "t-bulkhead-pending",
      "from": "pending",
      "to": "retry",
      "label": "bulkhead full",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "left"
    },
    {
      "id": "t-hold",
      "from": "pending",
      "to": "held",
      "label": "hold applies",
      "fromSide": "left",
      "toSide": "left",
      "via": [
        [
          30,
          157
        ],
        [
          30,
          479
        ]
      ]
    },
    {
      "id": "t-claim",
      "from": "due",
      "to": "sending",
      "label": "claim",
      "variant": "emphasis"
    },
    {
      "id": "t-delivered",
      "from": "sending",
      "to": "delivered",
      "label": "success",
      "variant": "emphasis"
    },
    {
      "id": "t-retry",
      "from": "sending",
      "to": "retry",
      "label": "retryable or stale claim",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "t-redrive",
      "from": "retry",
      "to": "due",
      "label": "re-drive",
      "labelDy": -22
    },
    {
      "id": "t-wait-bulkhead",
      "from": "due",
      "to": "retry",
      "label": "bulkhead full",
      "variant": "dashed",
      "labelDy": 50
    },
    {
      "id": "t-to-dead",
      "from": "sending",
      "to": "dead",
      "label": "permanent or stale claim",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "t-replay",
      "from": "dead",
      "to": "due",
      "label": "replay",
      "variant": "dashed"
    },
    {
      "id": "t-hold-due",
      "from": "due",
      "to": "held",
      "label": "hold applies",
      "labelDx": -46,
      "labelDy": 70
    },
    {
      "id": "t-release",
      "from": "held",
      "to": "due",
      "label": "release",
      "labelDx": 31,
      "labelDy": -44
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Main path",
      "items": [
        "Claim: key lock, hold check, HELD or SENDING",
        "State changes need the claim token"
      ]
    },
    {
      "dot": "orange",
      "title": "To RETRY_WAIT",
      "items": [
        "Transient, circuit open, bulkhead full, missing key",
        "Stale claim: 3 x timeout + 65 s"
      ]
    },
    {
      "dot": "rose",
      "title": "To DEAD_LETTERED",
      "items": [
        "Permanent, exhausted, ambiguous or stale",
        "Final state releases the next HELD"
      ]
    }
  ]
}
