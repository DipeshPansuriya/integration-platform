  "cards": [
    {
      "dot": "emerald",
      "title": "Main path",
      "items": [
        "PENDING to SENDING: stage 2 claims by conditional update; 0 rows = duplicate, acknowledged",
        "SENDING to DELIVERED on SUCCESS; DUE to HELD also applies"
      ]
    },
    {
      "dot": "orange",
      "title": "To RETRY_WAIT",
      "items": [
        "Transient after layer 1, circuit open, or ambiguous with idempotent receive",
        "Stale claim (timeout + 60 s) goes to RETRY_WAIT or DEAD_LETTERED as ambiguous"
      ]
    },
    {
      "dot": "rose",
      "title": "To DEAD_LETTERED",
      "items": [
        "Permanent, attempts exhausted, or ambiguous without idempotent receive",
        "Replay is audited and uses the versions pinned on arrival"
      ]
    }
  ]
