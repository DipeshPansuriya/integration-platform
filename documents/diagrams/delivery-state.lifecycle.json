{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Integration Platform - Delivery States",
    "output": "delivery-state.archify.html",
    "quality_profile": "showcase",
    "viewBox": [
      1040,
      640
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "Delivery path"
    },
    {
      "id": "waits",
      "label": "Waits and re-entry"
    },
    {
      "id": "terminal",
      "label": "Dead letter"
    }
  ],
  "states": [
    {
      "id": "pending",
      "type": "start",
      "label": "PENDING",
      "sublabel": "created",
      "lane": "main",
      "col": 0,
      "step": "01",
      "width": 96
    },
    {
      "id": "sending",
      "type": "active",
      "label": "SENDING",
      "sublabel": "claimed",
      "lane": "main",
      "col": 2,
      "step": "02",
      "width": 96
    },
    {
      "id": "delivered",
      "type": "success",
      "label": "DELIVERED",
      "sublabel": "terminal",
      "lane": "main",
      "col": 4,
      "step": "03",
      "width": 96
    },
    {
      "id": "held",
      "type": "waiting",
      "label": "HELD",
      "sublabel": "same key open",
      "lane": "waits",
      "col": 0,
      "width": 96
    },
    {
      "id": "due",
      "type": "active",
      "label": "DUE",
      "sublabel": "ready",
      "lane": "waits",
      "col": 1,
      "width": 96
    },
    {
      "id": "retry",
      "type": "failure",
      "label": "RETRY_WAIT",
      "sublabel": "waits in DB",
      "lane": "waits",
      "col": 2,
      "width": 96
    },
    {
      "id": "dead",
      "type": "failure",
      "label": "DEAD_LETTERED",
      "sublabel": "until replay",
      "lane": "terminal",
      "col": 1,
      "width": 96
    }
  ],
  "transitions": [
    {
      "id": "t-hold",
      "from": "pending",
      "to": "held",
      "label": "hold applies"
    },
    {
      "id": "t-release",
      "from": "held",
      "to": "due",
      "label": "release",
      "fromSide": "right",
      "toSide": "left",
      "route": "straight"
    },
    {
      "id": "t-claim",
      "from": "due",
      "to": "sending",
      "label": "claim + token",
      "variant": "emphasis",
      "fromSide": "top",
      "toSide": "bottom",
      "channelY": 250
    },
    {
      "id": "t-retry",
      "from": "sending",
      "to": "retry",
      "label": "retryable",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top",
      "channelY": 218
    },
    {
      "id": "t-redrive",
      "from": "retry",
      "to": "due",
      "label": "re-drive",
      "labelDy": -24
    },
    {
      "id": "t-dead",
      "from": "sending",
      "to": "dead",
      "label": "permanent",
      "variant": "security",
      "fromSide": "top",
      "toSide": "right",
      "via": [
        [
          402,
          96
        ],
        [
          800,
          96
        ],
        [
          800,
          479
        ]
      ]
    },
    {
      "id": "t-replay",
      "from": "dead",
      "to": "due",
      "label": "replay",
      "variant": "dashed",
      "fromSide": "top",
      "toSide": "bottom",
      "route": "straight"
    },
    {
      "id": "t-bulkhead",
      "from": "due",
      "to": "retry",
      "label": "bulkhead full",
      "variant": "dashed",
      "labelDy": 60
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Main path",
      "items": [
        "Claim: lock, hold check, HELD or SENDING",
        "State changes need the claim token"
      ]
    },
    {
      "dot": "orange",
      "title": "To RETRY_WAIT",
      "items": [
        "Transient, circuit open, bulkhead full",
        "Stale claim: 3 x timeout + 65 s"
      ]
    },
    {
      "dot": "rose",
      "title": "To DEAD_LETTERED",
      "items": [
        "Permanent, exhausted, or ambiguous",
        "Final state releases the next HELD"
      ]
    }
  ]
}
