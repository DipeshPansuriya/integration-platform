      },
      {
        "id": "recovery",
        "label": "Retry and dead letter",
        "focus": [
          "sending",
          "retry",
          "dead",
          "due"
        ],
        "note": "Layer 2 retry waits in the database; dead letters wait for an audited operator replay."
      }
    ]
  },
