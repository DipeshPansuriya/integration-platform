{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Configuration Workflow",
    "output": "workflow.archify.html",
    "quality_profile": "showcase",
    "viewBox": [
      1240,
      776
    ]
  },
  "lanes": [
    {
      "id": "configurator",
      "label": "Configurator (tenant admin for credentials)"
    },
    {
      "id": "approver",
      "label": "Approver - never the author"
    },
    {
      "id": "platform",
      "label": "Platform"
    },
    {
      "id": "support",
      "label": "Support"
    },
    {
      "id": "refusals",
      "label": "Refused or rejected",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "setup",
      "label": "Log in + register",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "define",
      "label": "Contracts, rules, mapping",
      "fromCol": 2,
      "toCol": 4,
      "variant": "emphasis"
    },
    {
      "id": "release",
      "label": "Approve, publish, monitor",
      "fromCol": 5,
      "toCol": 5,
      "variant": "security"
    }
  ],
  "mainPath": [
    "login",
    "systems",
    "contracts",
    "approveContract",
    "flow",
    "mapping",
    "submit",
    "approveBundle",
    "publish",
    "monitor"
  ],
  "nodes": [
    {
      "id": "login",
      "lane": "configurator",
      "col": 0,
      "type": "security",
      "label": "Log in",
      "sublabel": "Keycloak -> session",
      "width": 136
    },
    {
      "id": "systems",
      "lane": "configurator",
      "col": 1,
      "type": "frontend",
      "label": "Register systems",
      "sublabel": "systems, credentials, test",
      "width": 136
    },
    {
      "id": "contracts",
      "lane": "configurator",
      "col": 2,
      "type": "frontend",
      "label": "Contract versions",
      "sublabel": "source + target, import",
      "width": 136
    },
    {
      "id": "flow",
      "lane": "configurator",
      "col": 3,
      "type": "frontend",
      "label": "Interface + rules",
      "sublabel": "rule tables, test panel",
      "width": 136
    },
    {
      "id": "mapping",
      "lane": "configurator",
      "col": 4,
      "type": "frontend",
      "label": "Mapping per target",
      "sublabel": "sample run recorded",
      "width": 136
    },
    {
      "id": "submit",
      "lane": "configurator",
      "col": 5,
      "type": "frontend",
      "label": "Submit bundle",
      "sublabel": "with change note",
      "width": 136
    },
    {
      "id": "approveContract",
      "lane": "approver",
      "col": 2,
      "type": "security",
      "label": "Approve version",
      "sublabel": "then immutable",
      "width": 136
    },
    {
      "id": "approveBundle",
      "lane": "approver",
      "col": 5,
      "type": "security",
      "label": "Approve bundle",
      "sublabel": "role + DB CHECK",
      "width": 136
    },
    {
      "id": "publish",
      "lane": "platform",
      "col": 5,
      "type": "backend",
      "label": "Publish",
      "sublabel": "one transaction",
      "width": 136
    },
    {
      "id": "monitor",
      "lane": "support",
      "col": 5,
      "type": "database",
      "label": "Queue dashboard",
      "sublabel": "counts per flow, day",
      "width": 136
    },
    {
      "id": "replay",
      "lane": "support",
      "col": 4,
      "type": "backend",
      "label": "Replay dead letter",
      "sublabel": "planned: no API yet",
      "width": 136
    },
    {
      "id": "rejected",
      "lane": "refusals",
      "col": 3,
      "type": "external",
      "label": "Rejected",
      "sublabel": "planned: no reject API",
      "width": 136
    },
    {
      "id": "pinRefused",
      "lane": "refusals",
      "col": 5,
      "type": "external",
      "label": "Publish refused",
      "sublabel": "409, route + reason named",
      "width": 136
    }
  ],
  "edges": [
    {
      "id": "e-login",
      "from": "login",
      "to": "systems",
      "role": "main"
    },
    {
      "id": "e-systems",
      "from": "systems",
      "to": "contracts",
      "role": "main"
    },
    {
      "id": "e-contract-submit",
      "from": "contracts",
      "to": "approveContract",
      "label": "submit",
      "variant": "security",
      "role": "main"
    },
    {
      "id": "e-contract-ok",
      "from": "approveContract",
      "to": "flow",
      "label": "approved",
      "role": "main"
    },
    {
      "id": "e-flow",
      "from": "flow",
      "to": "mapping",
      "role": "main"
    },
    {
      "id": "e-mapping",
      "from": "mapping",
      "to": "submit",
      "role": "main"
    },
    {
      "id": "e-submit",
      "from": "submit",
      "to": "approveBundle",
      "label": "pending",
      "variant": "security",
      "role": "main"
    },
    {
      "id": "e-approve",
      "from": "approveBundle",
      "to": "publish",
      "label": "approve",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "e-publish",
      "from": "publish",
      "to": "monitor",
      "label": "live",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "e-pin-refused",
      "from": "publish",
      "to": "pinRefused",
      "label": "pin or sample-run gap",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "e-reject",
      "from": "approveBundle",
      "to": "rejected",
      "label": "reject (planned)",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "e-redraft",
      "from": "rejected",
      "to": "flow",
      "label": "redraft (planned)",
      "variant": "dashed",
      "role": "return"
    },
    {
      "id": "e-replay",
      "from": "monitor",
      "to": "replay",
      "label": "dead letter (planned)",
      "variant": "dashed",
      "role": "branch"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Configuration is data",
      "items": [
        "Every step writes rows (rules too, as ZEN decision tables): 0 deploys, 0 migrations",
        "Edits are drafts, never live; published versions are immutable"
      ]
    },
    {
      "dot": "rose",
      "title": "Approval gates",
      "items": [
        "Contract version and bundle: approver is never the author (403 + DB check)",
        "No change note or role: refused; reject is planned"
      ]
    },
    {
      "dot": "emerald",
      "title": "Publish (one transaction)",
      "items": [
        "Mappings must match their pinned contracts and pass a sample run, else 409",
        "Monitoring: queue dashboard; replay planned"
      ]
    }
  ]
}
