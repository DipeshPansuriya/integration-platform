<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2000/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.integrationplatform</groupId>
    <artifactId>integration-platform-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>platform-config</artifactId>
  <name>platform-config</name>
  <description>Flow configuration (E3): interfaces, routes, mappings, systems, contract drafts and version snapshots, and their admin/lifecycle APIs. No routing, no delivery, no registry roles yet (E5 extends this module's tables).</description>

  <!-- E3 seam (arjun-fullstack): the skeleton only. Lane B owns db/migration V2_2_* (T-014, T-018, T-020); lane C
       owns the APIs in adapter/in and application (T-015, T-019, T-021). Package root: io.integrationplatform.config. -->
  <dependencies>
    <!-- E7 lane B1 (T-163): the one audit event a configuration edit publishes is the shared domain's
         AuditEvent record (E7 seam c4c9486) - the shared module's own edge rule (no Spring, no other module)
         makes the downward direction the sanctioned one, as platform-delivery already does. -->
    <dependency>
      <groupId>io.integrationplatform</groupId>
      <artifactId>platform-domain</artifactId>
    </dependency>
    <!-- Configuration rows are served over the admin HTTP API (E3-F1-S1 / E3-F2-S1). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- E7 lane B2 (T-108, ADR-006): the mapping test endpoint runs the stored compiled expression through the
         TransformPort seam - config consumes the transform engine, never the reverse (the transform module stays
         engine-only; lane A's ArchUnit guards its edge). -->
    <dependency>
      <groupId>io.integrationplatform</groupId>
      <artifactId>platform-transform</artifactId>
    </dependency>
    <!-- E3 T36: annotations only - the admin controllers declare the statuses they really answer in the OpenAPI
         document (springdoc itself stays in platform-app); the version is the one springdoc already pulls. -->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations-jakarta</artifactId>
    </dependency>
    <!-- Tenant-scoped persistence base (the arch gate's CompliantRouteRepository pattern) - wave-0 glue
         (arjun-fullstack), requested by lane B's handoff: the persisted repositories build on it. -->
    <dependency>
      <groupId>io.integrationplatform</groupId>
      <artifactId>platform-tenancy</artifactId>
    </dependency>
    <!-- E5 seam (arjun-fullstack, F13): every library an E5 lane needs in this module, declared once so no E5 lane
         edits this pom (E6 edits it too). Lane A (T-105): JSON Schema validation (the one networknt version, R12)
         and the OpenAPI 3.x import (ADR-011:103). Lane B (T-104): the five controls of R13 on test-connection
         (breaker, retry, metrics) and its rate limit, from the platform's one resilience library (ADR-010:59).
         Lane C (T-185): the readiness health indicator for a missing key-encryption key (ADR-007 Decision 7 rule 5). -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.swagger.parser.v3</groupId>
      <artifactId>swagger-parser-v3</artifactId>
    </dependency>
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-core-jakarta</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-circuitbreaker</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-retry</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-ratelimiter</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-micrometer</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-health</artifactId>
    </dependency>
    <!-- The tables these APIs serve are rows (no JPA): JDBC (ADR-001, the delivery module's pattern),
         deployed by Flyway (V2_2_* configuration schema, lane B's checked-in migrations). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- Wave-0 glue (arjun-fullstack, the named pending-integration owner): Flyway + the PostgreSQL driver
         so the checked-in migrations deploy through the real mechanism and the container suites reach the DB. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- E14 T-056 (sanjay-developer, F8): ADR-012 section 2 - platform-config owns the job_definition rows and the
         schedule sync (reads the rows, reconciles db-scheduler; a row change takes effect at the next sync). The
         version is managed in the parent pom (the seam). -->
    <dependency>
      <groupId>com.github.kagkarlsson</groupId>
      <artifactId>db-scheduler-spring-boot-starter</artifactId>
    </dependency>
    <!-- E6 seam (sanjay-developer, T-024): rule sets (ZEN decision tables, ADR-003) are checked at save and
         evaluated behind RuleEvaluationPort; only rule/adapter/out touches the engine. Version managed in the root. -->
    <dependency>
      <groupId>io.gorules</groupId>
      <artifactId>zen-engine</artifactId>
    </dependency>
    <!-- spring-boot-starter-test comes from the parent for every module. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- E3 seam continued (arjun-fullstack): lane A's Testcontainers suites (T-016 rows-only onboarding, T-092/T-093
         real-API defect tests) boot a composed system from this module, and lane B/C's DB tests reuse the same deps -
         so the container test dependencies are armed here once and no lane edits this pom again. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>