<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2000/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.integrationplatform</groupId>
    <artifactId>integration-platform-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>platform-config</artifactId>
  <name>platform-config</name>
  <description>Flow configuration (E3): interfaces, routes, mappings, systems, contract drafts and version snapshots, and their admin/lifecycle APIs. No routing, no delivery, no registry roles yet (E5 extends this module's tables).</description>

  <!-- E3 seam (arjun-fullstack): the skeleton only. Lane B owns db/migration V2_2_* (T-014, T-018, T-020); lane C
       owns the APIs in adapter/in and application (T-015, T-019, T-021). Package root: io.integrationplatform.config. -->
  <dependencies>
    <!-- Configuration rows are served over the admin HTTP API (E3-F1-S1 / E3-F2-S1). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Tenant-scoped persistence base (the arch gate's CompliantRouteRepository pattern) - wave-0 glue
         (arjun-fullstack), requested by lane B's handoff: the persisted repositories build on it. -->
    <dependency>
      <groupId>io.integrationplatform</groupId>
      <artifactId>platform-tenancy</artifactId>
    </dependency>
    <!-- The tables these APIs serve are rows (no JPA): JDBC (ADR-001, the delivery module's pattern),
         deployed by Flyway (V2_2_* configuration schema, lane B's checked-in migrations). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- Wave-0 glue (arjun-fullstack, the named pending-integration owner): Flyway + the PostgreSQL driver
         so the checked-in migrations deploy through the real mechanism and the container suites reach the DB. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- spring-boot-starter-test comes from the parent for every module. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- E3 seam continued (arjun-fullstack): lane A's Testcontainers suites (T-016 rows-only onboarding, T-092/T-093
         real-API defect tests) boot a composed system from this module, and lane B/C's DB tests reuse the same deps -
         so the container test dependencies are armed here once and no lane edits this pom again. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>